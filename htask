# Claude Code's task statuses, and the older TodoWrite list's.
CLAUDE_STATUS = {"pending": "todo", "in_progress": "doing", "completed": "done", "deleted": "dropped"}


def _mirror(conn: sqlite3.Connection, project: str, agent: str, pane: str | None, now: float):
    """An upsert for tasks mirrored from an agent's own task list, keyed by external_id."""

    def upsert(key, title=None, description=None, status=None) -> int:
        row = conn.execute("SELECT id FROM tasks WHERE external_id = ?", (key,)).fetchone()
        if row is None and title is not None:
            # The agent may have run `htask add` for the same step too (a session without the task
            # tool falls back to htask; a confused one does both). Link to that task instead of
            # adding a duplicate: same repo, same terminal, same title, not yet linked, not archived.
            row = conn.execute(
                "SELECT id FROM tasks WHERE external_id IS NULL AND archived_at IS NULL AND project = ?"
                " AND pane_id IS ? AND lower(trim(title)) = lower(trim(?)) ORDER BY id DESC LIMIT 1",
                (project, pane, title)).fetchone()
            if row is not None:
                conn.execute("UPDATE tasks SET external_id = ? WHERE id = ?", (key, row["id"]))
        if row is None:
            if title is None:
                return 0  # an update for a task created before the hook existed
            conn.execute(
                "INSERT INTO tasks (project, title, description, status, agent, pane_id,"
                " created_at, updated_at, completed_at, external_id) VALUES (?,?,?,?,?,?,?,?,?,?)",
                (project, title, description or "", status or "todo", agent, pane,
                 now, now, now if status == "done" else None, key))
            return 1
        fields = {k: v for k, v in (("title", title), ("description", description), ("status", status)) if v is not None}
        if not fields:
            return 0
        fields["updated_at"] = now
        if status is not None:
            fields["completed_at"] = now if status == "done" else None
        conn.execute(f"UPDATE tasks SET {', '.join(f'{k} = ?' for k in fields)} WHERE id = ?",
                     (*fields.values(), row["id"]))
        return 1

    return upsert


def _sync_full_list(conn: sqlite3.Connection, upsert, prefix: str, steps: list[tuple[str, str]], now: float) -> int:
    """Mirror a list the agent resends whole each time (TodoWrite, Codex update_plan).

    Steps are keyed by text under `prefix`. A step this session listed before but has now left out
    was revised away: it's marked dropped, unless it was already done.
    """
    keys = [prefix + title for title, _ in steps]
    touched = sum(upsert(prefix + title, title, None, status) for title, status in steps)
    marks = ",".join("?" * len(keys)) or "''"
    gone = conn.execute(
        f"UPDATE tasks SET status = 'dropped', updated_at = ? WHERE substr(external_id, 1, ?) = ?"
        f" AND external_id NOT IN ({marks}) AND status NOT IN ('done', 'dropped') AND archived_at IS NULL",
        (now, len(prefix), prefix, *keys)).rowcount
    return touched + gone


def sync_claude(event: dict, conn: sqlite3.Connection) -> int:
    """Mirror one Claude Code PostToolUse event into the task table. Returns rows touched.

    TaskCreate/TaskUpdate carry Claude's per-session task id ("1", "2", ...):
    TaskCreate's id is only in the response ({"task": {"id": "1"}}), TaskUpdate's
    is in the input. TodoWrite resends the whole list each time, keyed by text.
    """
    tool, inp = event.get("tool_name"), event.get("tool_input") or {}
    resp = event.get("tool_response") or {}
    session, now = event.get("session_id") or "unknown", time.time()
    project = project_root(event.get("cwd") or os.getcwd())
    upsert = _mirror(conn, project, "claude", origin_id(), now)

    prefix = f"claude:{session}:"

    def link_deps(claude_id) -> None:
        """Claude's own 'blocked by' ids, if its task tool sent any, as htask dependencies."""
        wanted = [str(x) for k in ("addBlockedBy", "blockedBy") for x in (inp.get(k) or [])]
        if not wanted:
            return
        mine = conn.execute("SELECT id FROM tasks WHERE external_id = ?", (prefix + str(claude_id),)).fetchone()
        for other in wanted:
            dep = conn.execute("SELECT id FROM tasks WHERE external_id = ?", (prefix + other,)).fetchone()
            if mine and dep:
                try:
                    add_deps(conn, mine["id"], [dep["id"]])
                except SystemExit:
                    pass  # a loop or a missing task: leave it out rather than fail the hook

    if tool == "TaskCreate":
        task_id = (resp.get("task") or {}).get("id") if isinstance(resp, dict) else None
        if task_id is None:
            return 0
        n = upsert(prefix + str(task_id), inp.get("subject") or "(untitled)", inp.get("description"), "todo")
        link_deps(task_id)
        return n
    if tool == "TaskUpdate" and inp.get("taskId") is not None:
        n = upsert(prefix + str(inp["taskId"]), inp.get("subject"), inp.get("description"),
                   CLAUDE_STATUS.get(inp.get("status")))
        link_deps(inp["taskId"])
        return n
    if tool == "ExitPlanMode" and (inp.get("plan") or "").strip():
        # PostToolUse runs only when the tool succeeded, that is, when the plan was approved.
        # One task for the plan; its steps come from the task tool or htask, in order.
        import hashlib
        plan = inp["plan"].strip()
        lines = plan.splitlines()
        title = next((l.lstrip("#").strip() for l in lines if l.strip()), "Plan")
        if not title.lower().startswith("plan"):
            title = f"Plan: {title}"
        body = " ".join(l.strip().lstrip("#").strip() for l in lines[1:] if l.strip())
        description = (body[:400] + ("…" if len(body) > 400 else ""))
        if inp.get("planFilePath"):
            description += f"\nPlan file: {inp['planFilePath']}"
        key = prefix + "plan:" + hashlib.sha1(plan.encode()).hexdigest()[:12]
        return upsert(key, title[:120], description, "doing")
    if tool == "TodoWrite":
        steps = [(t["content"], CLAUDE_STATUS.get(t.get("status"), "todo"))
                 for t in inp.get("todos") or [] if t.get("content")]
        return _sync_full_list(conn, upsert, prefix + "todo:", steps, now)
    return 0


def _hc_bin() -> str:
    return os.environ.get("HTASK_HC") or shutil.which("hc") or str(Path.home() / ".local" / "bin" / "hc")


def codex_terminal(project: str) -> str | None:
    """The Herdr app terminal a Codex hook belongs to, or None when it can't be told for sure.

    Codex can run hooks from its shared background app-server rather than the agent's terminal,
    so HC_TERMINAL_ID may be missing. Look for a live Codex terminal whose current folder is in
    this repo; with several, the one that's working. Better no terminal than the wrong one.
    """
    def hc(*args):
        out = subprocess.run([_hc_bin(), *args, "--json"], capture_output=True, text=True, timeout=3)
        return json.loads(out.stdout or "{}")

    try:
        found = []
        for t in hc("ls").get("terminals", []):
            if "/" in t.get("address", "") or t.get("state") != "live" or t.get("agent") != "codex":
                continue
            info = hc("get", t["address"])
            cwd = (info.get("foreground") or {}).get("cwd") or info.get("cwd") or ""
            if cwd and project_root(cwd) == project:
                found.append(info)
        if len(found) > 1:
            found = [t for t in found if (t.get("status") or {}).get("state") == "working"]
        return found[0]["address"] if len(found) == 1 else None
    except (OSError, ValueError, subprocess.TimeoutExpired, KeyError):
        return None


CODEX_STATUS = {"pending": "todo", "in_progress": "doing", "completed": "done"}


def sync_codex(event: dict, conn: sqlite3.Connection) -> int:
    """Mirror one Codex PostToolUse(update_plan) event: the whole plan, keyed by step text."""
    if event.get("tool_name") != "update_plan":
        return 0
    inp = event.get("tool_input") or {}
    if isinstance(inp, str):  # Codex may send tool_input as a JSON string
        try:
            inp = json.loads(inp)
        except ValueError:
            return 0
    steps = [(s["step"].strip(), CODEX_STATUS.get(s.get("status"), "todo"))
             for s in inp.get("plan") or [] if isinstance(s, dict) and (s.get("step") or "").strip()]
    if not steps:
        return 0
    session, now = event.get("session_id") or "unknown", time.time()
    project = project_root(event.get("cwd") or os.getcwd())
    upsert = _mirror(conn, project, "codex", origin_id() or codex_terminal(project), now)
    return _sync_full_list(conn, upsert, f"codex:{session}:step:", steps, now)


STATUS_WORDS = {"done": "done", "dropped": "dropped", "todo": "back to to-do", "doing": "in progress",
                "blocked": "blocked"}


def human_changes(conn: sqlite3.Connection, session: str, cwd: str, pane: str | None) -> list[str]:
    """What the human changed since this Claude session last asked, as lines for its context.

    Only changes made with --by you, and only to tasks that concern the session: its own
    (mirrored from its task tool, or made from its terminal), plus tasks the human added to
    its repo. The first call only sets the cursor: an old backlog isn't news.
    """
    latest = conn.execute("SELECT coalesce(max(id), 0) FROM changes").fetchone()[0]
    row = conn.execute("SELECT last_change FROM hook_cursor WHERE session = ?", (session,)).fetchone()
    with conn:
        conn.execute("INSERT INTO hook_cursor (session, last_change) VALUES (?, ?)"
                     " ON CONFLICT(session) DO UPDATE SET last_change = excluded.last_change", (session, latest))
    if row is None:
        return []
    rows = conn.execute(
        "SELECT c.what, c.detail, t.id, t.title, t.project, t.pane_id, t.external_id FROM changes c"
        " JOIN tasks t ON t.id = c.task_id WHERE c.id > ? AND c.by = 'you' ORDER BY c.id",
        (row["last_change"],)).fetchall()
    project, mine = None, f"claude:{session}:"
    lines = []
    for r in rows:
        if r["what"] == "added":
            # A task the human added belongs to no agent yet: news for every session in its repo.
            project = project or project_root(cwd)
            if r["project"] != project:
                continue
        elif not ((r["external_id"] or "").startswith(mine) or (pane is not None and r["pane_id"] == pane)):
            continue
        ref = f'htask #{r["id"]} "{r["title"]}"'
        claude_id = (r["external_id"] or "")[len(mine):] if (r["external_id"] or "").startswith(mine) else None
        yours = f" (your task {claude_id})" if claude_id and not claude_id.startswith("todo:") else ""
        if r["what"] == "added":
            lines.append(f"The human added {ref} to this repo's task list.")
        elif r["what"].startswith("status:"):
            status = r["what"].split(":", 1)[1]
            lines.append(f"The human marked {ref}{yours} {STATUS_WORDS.get(status, status)}"
                         + (f': "{r["detail"]}"' if r["detail"] else "") + ".")
        elif r["what"] == "note":
            lines.append(f'The human left a note on {ref}{yours}: "{r["detail"]}".')
        elif r["what"] == "edit":
            lines.append(f"The human edited {ref}{yours}; run `htask list` to see it.")
    if lines:
        lines.append("These changes came from the Herdr task panel. Update your own task list to match"
                     " (TaskUpdate), so your next update doesn't undo them.")
    return lines


def cmd_inbox(args) -> None:
    """Claude Code hook (PostToolUse, UserPromptSubmit): pass on the human's task changes."""
    try:
        event = json.load(sys.stdin)
        conn = connect()
        lines = human_changes(conn, event.get("session_id") or "unknown",
                              event.get("cwd") or os.getcwd(), origin_id())
        if lines:
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": event.get("hook_event_name", "PostToolUse"),
                "additionalContext": "\n".join(lines)}}))
    except Exception as e:  # noqa: BLE001 - a broken hook must not block the agent
        print(f"htask inbox: {e}", file=sys.stderr)


def cmd_hook(args) -> None:
    """Hook entry point. Never fails the agent's tool call: errors go to stderr, exit 0."""
    if args.agent == "claude-inbox":
        return cmd_inbox(args)
    try:
        event = json.load(sys.stdin)
        conn = connect()
        with writing(conn, project_root(event.get("cwd") or os.getcwd())):
            (sync_codex if args.agent == "codex" else sync_claude)(event, conn)
    except Exception as e:  # noqa: BLE001 - a broken hook must not block the agent
        print(f"htask hook: {e}", file=sys.stderr)


def cmd_plugin_open(args) -> None:
    """Plugin action: open the panel in a right split beside the focused pane."""
    herdr = os.environ.get("HERDR_BIN_PATH", "herdr")
    ctx = json.loads(os.environ.get("HERDR_PLUGIN_CONTEXT_JSON") or "{}")
    cmd = [herdr, "plugin", "pane", "open", "--plugin", PLUGIN_ID,
           "--entrypoint", "panel", "--placement", "split", "--direction", "right"]
    if ctx.get("focused_pane_id"):
        cmd += ["--target-pane", ctx["focused_pane_id"]]
    out = subprocess.run(cmd, capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(out.stderr or out.stdout)
    try:
        pane_id = json.loads(out.stdout)["result"]["plugin_pane"]["pane"]["pane_id"]
        subprocess.run([herdr, "pane", "rename", pane_id, "tasks"], capture_output=True)
    except (KeyError, ValueError, TypeError):
        pass


# --- panel ---------------------------------------------------------------------

def focused_context(prev: dict | None) -> dict:
    """Which pane the panel should follow: {pane_id, cwd, agent}.

    Polls `herdr pane current` (the focused pane). When the user focuses the
    panel itself, keep showing the pane they came from.
    """
    own = os.environ.get("HERDR_PANE_ID")
    if os.environ.get("HERDR_ENV") != "1":
        return prev or {"pane_id": None, "cwd": os.getcwd(), "agent": None}
    if prev is None:
        ctx = json.loads(os.environ.get("HERDR_PLUGIN_CONTEXT_JSON") or "{}")
        prev = {"pane_id": ctx.get("focused_pane_id"),
                "cwd": ctx.get("focused_pane_cwd") or ctx.get("workspace_cwd") or os.getcwd(),
                "agent": ctx.get("focused_pane_agent")}
    herdr = os.environ.get("HERDR_BIN_PATH", "herdr")
    # `pane current` answers for the caller's HERDR_PANE_ID when it is set,
    # which would be this panel. Without it, Herdr reports the focused pane.
    env = {k: v for k, v in os.environ.items() if k != "HERDR_PANE_ID"}
    try:
        out = subprocess.run([herdr, "pane", "current"], capture_output=True,
                             text=True, timeout=2, env=env)
        pane = json.loads(out.stdout)["result"]["pane"]
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired):
        return prev
    if pane.get("pane_id") == own:
        return prev
    return {"pane_id": pane.get("pane_id"),
            "cwd": pane.get("foreground_cwd") or pane.get("cwd") or prev["cwd"],
            "agent": pane.get("agent")}


DONE_SHOWN = 5  # done tasks shown; the rest are a "+N more" line (htask clean clears them)


def order_tasks(tasks: list[sqlite3.Row], focused_pane_id: str | None,
                show_done: bool, show_todo: bool = True,
                show_dropped: bool = False) -> list[tuple[str, list[sqlite3.Row], int]]:
    """The panel's sections in display order, as (title, rows, hidden count).

    Same policy as the app panel's sections(): Blocked first because it needs
    you; within each open section the focused pane's tasks first, then id order
    (sorted() is stable); Done shows the newest few; dropped tasks don't show.
    Empty sections are skipped by the renderer.
    """
    def by(status):
        rows = [t for t in tasks if t["status"] == status]
        return sorted(rows, key=lambda t: not (focused_pane_id and t["pane_id"] == focused_pane_id))
    sections = [("BLOCKED", by("blocked"), 0), ("IN PROGRESS", by("doing"), 0)]
    if show_todo:
        sections.append(("TO DO", by("todo"), 0))
    if show_done:
        done = sorted((t for t in tasks if t["status"] == "done"),
                      key=lambda t: t["completed_at"] or 0, reverse=True)
        sections.append(("DONE", done[:DONE_SHOWN], max(0, len(done) - DONE_SHOWN)))
    if show_dropped:
        sections.append(("DROPPED", sorted((t for t in tasks if t["status"] == "dropped"),
                                           key=lambda t: t["updated_at"] or 0, reverse=True), 0))
    return sections


def run_panel(args) -> None:
    import curses
    curses.wrapper(lambda scr: _panel(scr, args))


STATUS_GLYPH = {"todo": "○", "doing": "◐", "blocked": "✗", "done": "●", "dropped": "–"}


def _panel(scr, args) -> None:
    import curses
    curses.curs_set(0)
    curses.use_default_colors()
    palette = {"doing": curses.COLOR_YELLOW, "blocked": curses.COLOR_RED,
               "todo": curses.COLOR_CYAN, "done": curses.COLOR_GREEN,
               "dropped": curses.COLOR_WHITE, "head": curses.COLOR_MAGENTA}
    color = {}
    for i, (name, fg) in enumerate(palette.items(), start=1):
        curses.init_pair(i, fg, -1)
        color[name] = curses.color_pair(i)
    scr.timeout(400)

    conn = connect()
    ctx, last_poll, last_version = None, 0.0, None
    show_done, show_desc, show_archived, show_todo, show_dropped, scroll = True, True, False, True, False, 0
    lines: list[tuple[str, int]] = []
    dirty = True

    while True:
        now = time.monotonic()
        if args.project is None and now - last_poll > 1.0:
            new_ctx = focused_context(ctx)
            dirty |= new_ctx != ctx
            ctx, last_poll = new_ctx, now
        elif ctx is None:
            ctx = {"pane_id": None, "cwd": args.project, "agent": None}
        version = conn.execute("PRAGMA data_version").fetchone()[0]
        dirty |= version != last_version
        last_version = version

        h, w = scr.getmaxyx()
        if dirty:
            project = project_root(ctx["cwd"])
            tasks = fetch_tasks(conn, project)
            archived = sorted(fetch_tasks(conn, project, archived=True),
                              key=lambda t: t["archived_at"] or 0, reverse=True) if show_archived else None
            lines = _render(tasks, project, ctx, w, show_done, show_desc, color, archived, show_todo, show_dropped)
            dirty = False
        scroll = max(0, min(scroll, len(lines) - h))
        scr.erase()
        for y, (text, attr) in enumerate(lines[scroll:scroll + h]):
            try:
                scr.addnstr(y, 0, text, w - 1, attr)
            except curses.error:
                pass
        scr.refresh()

        key = scr.getch()
        if key in (ord("q"), 27):
            return
        if key in (ord("j"), curses.KEY_DOWN):
            scroll += 1
        elif key in (ord("k"), curses.KEY_UP):
            scroll = max(0, scroll - 1)
        elif key == ord("d"):
            show_done, dirty = not show_done, True
        elif key == ord("a"):
            show_archived, dirty = not show_archived, True
        elif key == ord("t"):
            show_todo, dirty = not show_todo, True
        elif key == ord("x"):
            show_dropped, dirty = not show_dropped, True
        elif key == ord("v"):
            show_desc, dirty = not show_desc, True
        elif key == curses.KEY_RESIZE:
            dirty = True


def _render(tasks, project, ctx, width, show_done, show_desc, color, archived=None,
            show_todo=True, show_dropped=False) -> list[tuple[str, int]]:
    import curses
    width = max(width - 1, 20)
    open_ = [t for t in tasks if t["status"] not in ("done", "dropped")]
    done = [t for t in tasks if t["status"] == "done"]
    total = len(open_) + len(done)
    bar_w = max(width - 12, 5)
    filled = round(bar_w * len(done) / total) if total else 0

    out: list[tuple[str, int]] = [
        (os.path.basename(project) or project, color["head"] | curses.A_BOLD),
        (f"{ctx.get('agent') or 'no agent'}  {ctx.get('pane_id') or ''}", curses.A_DIM),
        ("█" * filled + "░" * (bar_w - filled) + f" {len(done)}/{total}", color["done"]),
        ("", 0),
    ]
    sections = order_tasks(tasks, ctx.get("pane_id"), show_done, show_todo, show_dropped)
    # "›" (this pane's task) only tells tasks apart when the open ones come from more than one
    # pane, and never on finished rows.
    mixed = len({t["pane_id"] for t in tasks if t["status"] not in ("done", "dropped") and t["pane_id"]}) > 1
    if not any(rows for _, rows, _ in sections):
        out.append(("No tasks yet.", curses.A_DIM))
        out.append(('Agents add them with: htask add "title" -d "..."', curses.A_DIM))
    for title, rows, more in sections:
        if not rows:
            continue
        out.append((f"{title} ({len(rows) + more})", curses.A_BOLD | curses.A_UNDERLINE))
        for t in rows:
            mine = "›" if (mixed and t["status"] not in ("done", "dropped") and ctx.get("pane_id")
                           and t["pane_id"] == ctx["pane_id"]) else " "
            head = f"{mine}{STATUS_GLYPH[t['status']]} #{t['id']} "
            attr = color[t["status"]] | (curses.A_DIM if t["status"] == "done" else 0)
            wrapped = textwrap.wrap(t["title"], width - len(head)) or [""]
            out.append((head + wrapped[0], attr))
            out.extend((" " * len(head) + extra, attr) for extra in wrapped[1:])
            if show_desc and t["status"] != "done":
                for field, prefix in (("description", ""), ("note", "↳ ")):
                    if t[field]:
                        for line in textwrap.wrap(prefix + t[field], width - len(head)):
                            out.append((" " * len(head) + line, curses.A_DIM))
        if more:
            out.append((f"      +{more} more (htask clean to clear)", curses.A_DIM))
        out.append(("", 0))
    if archived is not None:
        # Archived tasks (`a`): newest first, dimmed. `htask reopen <id>` brings one back.
        out.append((f"ARCHIVED ({len(archived)})", curses.A_BOLD | curses.A_UNDERLINE))
        if not archived:
            out.append(("  Nothing archived in this repo.", curses.A_DIM))
        for t in archived:
            out.append((f" {STATUS_GLYPH[t['status']]} #{t['id']} {t['title']}", curses.A_DIM))
        out.append(("", 0))
    out.append(("q quit  j/k scroll  t to-do  d done  x dropped  a archived  v details", curses.A_DIM))
    return out


# --- entry ---------------------------------------------------------------------

def main(argv=None) -> None:
    p = argparse.ArgumentParser(prog="htask", description=__doc__.split("\n\n")[0])
    p.add_argument("--version", action="version", version=f"htask {__version__}")
    p.add_argument("--project", help="project dir (default: git root of cwd)")
    p.add_argument("--by", help="who is making the change (the app panel passes 'you')")
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add", help="create a task, prints its id")
    a.add_argument("title")
    a.add_argument("-d", "--description")
    a.add_argument("--status", choices=STATUSES, default="todo")
    a.add_argument("--agent", help="who added it (default: detected from the environment)")
    a.add_argument("--after", action="append", metavar="IDS", help="task(s) this one comes after: 3 or 3,4")
    a.add_argument("--from", dest="from_id", type=int, metavar="ID", help="the task this one came out of (a follow-up)")
    a.set_defaults(fn=cmd_add)

    for name, status, helptext in (
        ("start", "doing", "mark tasks in progress"),
        ("done", "done", "mark tasks complete"),
        ("block", "blocked", "mark tasks blocked (-m reason)"),
        ("drop", "dropped", "abandon tasks"),
        ("reopen", "todo", "move tasks back to todo"),
    ):
        s = sub.add_parser(name, help=helptext)
        s.add_argument("ids", type=int, nargs="+")
        s.add_argument("-m", "--message", help="also set the task's note")
        if status == "done":
            s.add_argument("--force", action="store_true", help="even if it comes after a task that isn't done")
        s.set_defaults(fn=lambda args, st=status: set_status(args, st))

    n = sub.add_parser("note", help="set a progress note on a task")
    n.add_argument("id", type=int)
    n.add_argument("text")
    n.set_defaults(fn=cmd_note)

    e = sub.add_parser("edit", help="change title or description")
    e.add_argument("id", type=int)
    e.add_argument("--title")
    e.add_argument("-d", "--description")
    e.add_argument("--from", dest="from_id", type=int, metavar="ID", help="the task it came out of (0 clears)")
    e.set_defaults(fn=cmd_edit)

    dp = sub.add_parser("depend", help="set what a task comes after")
    dp.add_argument("id", type=int)
    dp.add_argument("--on", action="append", metavar="IDS", help="task(s) it comes after: 3 or 3,4")
    dp.add_argument("--clear", action="store_true", help="remove its dependencies first")
    dp.set_defaults(fn=cmd_depend)

    sub.add_parser("next", help="the first to-do that isn't waiting on another task").set_defaults(fn=cmd_next)

    ls = sub.add_parser("list", help="list this project's open tasks")
    ls.add_argument("--all", action="store_true", help="include done/dropped")
    ls.add_argument("--json", action="store_true")
    ls.add_argument("--archived", action="store_true", help="only tasks put away by `htask clean`")
    ls.add_argument("--everywhere", action="store_true", help="every repo's tasks, not just this one's")
    ls.set_defaults(fn=cmd_list)

    ar = sub.add_parser("archive", help="archive done or dropped tasks now")
    ar.add_argument("ids", type=int, nargs="+")
    ar.set_defaults(fn=cmd_archive)

    cl = sub.add_parser("clean", help="archive done/dropped tasks older than --days")
    cl.add_argument("--days", type=float, default=7, help="age in days (default 7; 0 = all done)")
    cl.add_argument("--everywhere", action="store_true", help="every project, not just this one")
    cl.add_argument("--dry-run", action="store_true", help="list what would be archived")
    cl.set_defaults(fn=cmd_clean)

    sub.add_parser("doctor", help="check the install: links, hooks, app mod, TUI plugin, DB").set_defaults(fn=cmd_doctor)

    up = sub.add_parser("update", help="git pull this checkout, re-install, refresh connected agents")
    up.add_argument("--check", action="store_true", help="only say whether an update is available")
    up.set_defaults(fn=cmd_update)

    cn = sub.add_parser("connect", help="set up (or --remove) htask for Claude Code, Codex, Pi")
    cn.add_argument("target", choices=["status", "all", *CONNECT_AGENTS])
    cn.add_argument("--remove", action="store_true", help="take htask's hooks and instructions out")
    cn.add_argument("--json", action="store_true", help="with status: JSON")
    cn.set_defaults(fn=cmd_connect)

    sm = sub.add_parser("summary", help="JSON counts for this project and blocked tasks everywhere")
    sm.set_defaults(fn=cmd_summary)

    hk = sub.add_parser("hook", help="agent hook: mirror the agent's own task list (reads stdin)")
    hk.add_argument("agent", choices=["claude", "claude-inbox", "codex"],
                    help="claude / codex: mirror its task list or plan; claude-inbox: tell it what the human changed")
    hk.set_defaults(fn=cmd_hook)

    sub.add_parser("panel", help="run the TUI panel").set_defaults(fn=run_panel)
    sub.add_parser("plugin-open", help=argparse.SUPPRESS).set_defaults(fn=cmd_plugin_open)

    args = p.parse_args(argv)
    args.fn(args)


if __name__ == "__main__":
    main()
