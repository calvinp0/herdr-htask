#!/usr/bin/env python3
"""htask: a shared task list for coding agents, shown in a Herdr side panel.

Agents (Claude Code, Codex, ...) record work with the CLI:

    htask add "Parse ORCA output" -d "Handle the new 6.x energy block"
    htask start 3
    htask note 3 "regex works for 6.0, 6.1 untested"
    htask done 3

Every task belongs to a project, the git root of the directory the command ran
in. `htask panel` is the TUI that Herdr opens in a right split: it follows
the focused pane, shows that pane's project, and redraws when the DB changes.

Stdlib only. Storage: $HTASK_DB, else $XDG_DATA_HOME/herdr-tasks/tasks.db.
"""
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import subprocess
import sys
import textwrap
import time
from contextlib import contextmanager
from pathlib import Path

STATUSES = ("todo", "doing", "blocked", "done", "dropped")
PLUGIN_ID = "calvin.htask"

SCHEMA = """
CREATE TABLE IF NOT EXISTS tasks (
    id           INTEGER PRIMARY KEY,
    project      TEXT NOT NULL,
    title        TEXT NOT NULL,
    description  TEXT NOT NULL DEFAULT '',
    status       TEXT NOT NULL DEFAULT 'todo'
                 CHECK (status IN ('todo','doing','blocked','done','dropped')),
    note         TEXT NOT NULL DEFAULT '',
    agent        TEXT,
    pane_id      TEXT,
    created_at   REAL NOT NULL,
    updated_at   REAL NOT NULL,
    completed_at REAL
);
CREATE INDEX IF NOT EXISTS tasks_project ON tasks (project, status);
-- Who changed what. by = 'you' for the human (the app panel passes --by you), so agents can be
-- told about changes they didn't make.
CREATE TABLE IF NOT EXISTS changes (
    id      INTEGER PRIMARY KEY,
    task_id INTEGER NOT NULL,
    at      REAL NOT NULL,
    by      TEXT,
    what    TEXT NOT NULL,   -- added | status:<status> | note | edit
    detail  TEXT
);
-- How far each Claude session has read `changes` (the inbox hook).
CREATE TABLE IF NOT EXISTS hook_cursor (
    session     TEXT PRIMARY KEY,
    last_change INTEGER NOT NULL
);
"""


# --- storage -----------------------------------------------------------------

def db_path() -> Path:
    if os.environ.get("HTASK_DB"):
        return Path(os.environ["HTASK_DB"]).expanduser()
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return Path(base) / "herdr-tasks" / "tasks.db"


def connect() -> sqlite3.Connection:
    path = db_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(path, timeout=10)
    conn.row_factory = sqlite3.Row
    # WAL lets the panel read while several agents write.
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA busy_timeout=10000")
    conn.executescript(SCHEMA)
    # v2: external_id ties a row to an agent's own task (claude:<session>:<task id>),
    # so the hooks update the row they created instead of adding duplicates.
    columns = {r["name"] for r in conn.execute("PRAGMA table_info(tasks)")}
    if "external_id" not in columns:
        with conn:
            conn.execute("ALTER TABLE tasks ADD COLUMN external_id TEXT")
            conn.execute("CREATE UNIQUE INDEX IF NOT EXISTS tasks_external ON tasks (external_id)")
    # v3: `htask clean` archives old done/dropped tasks instead of deleting them.
    if "archived_at" not in columns:
        with conn:
            conn.execute("ALTER TABLE tasks ADD COLUMN archived_at REAL")
    return conn


def signal_path() -> Path:
    """A file rewritten after every change. The app panel watches its folder.

    The DB folder itself can't be watched: SQLite creates and deletes its -wal
    and -shm files on every connection, readers included, so a watcher that
    reloads on change would trigger itself forever.
    """
    return db_path().parent / "signal" / "changed"


@contextmanager
def writing(conn: sqlite3.Connection, project: str | None = None):
    """Commit (or roll back) the block, then announce the change."""
    with conn:
        yield
    signal = signal_path()
    signal.parent.mkdir(parents=True, exist_ok=True)
    signal.write_text(f"{time.time()}\n")
    if project:
        report_progress(conn, project)


def report_progress(conn: sqlite3.Connection, project: str) -> None:
    """Herdr TUI sidebar: set the $tasks token ("3/7") on this agent's pane and workspace.

    Only inside a Herdr TUI pane (HERDR_ENV=1). The app panel needs none of
    this: it reads the DB itself. Best effort: a failure never fails the command.
    """
    pane, workspace = os.environ.get("HERDR_PANE_ID"), os.environ.get("HERDR_WORKSPACE_ID")
    if os.environ.get("HERDR_ENV") != "1" or not pane:
        return
    done, total = conn.execute(
        "SELECT coalesce(sum(status = 'done'), 0), coalesce(sum(status != 'dropped'), 0)"
        " FROM tasks WHERE project = ? AND archived_at IS NULL", (project,)).fetchone()
    token = ["--token", f"tasks={done}/{total}"] if total else ["--clear-token", "tasks"]
    herdr = os.environ.get("HERDR_BIN_PATH", "herdr")
    targets = [["pane", "report-metadata", pane]] + ([["workspace", "report-metadata", workspace]] if workspace else [])
    for target in targets:
        try:
            subprocess.run([herdr, *target, "--source", "htask", *token],
                           capture_output=True, timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            pass


_root_cache: dict[str, str] = {}


def project_root(cwd: str) -> str:
    """Git toplevel of cwd, or cwd itself outside a repo. Cached per cwd."""
    cwd = os.path.realpath(os.path.expanduser(cwd))
    if cwd not in _root_cache:
        try:
            out = subprocess.run(
                ["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                capture_output=True, text=True, timeout=3,
            )
            root = out.stdout.strip() if out.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired):
            root = ""
        _root_cache[cwd] = os.path.realpath(root) if root else cwd
    return _root_cache[cwd]


def detect_agent() -> str | None:
    if os.environ.get("HTASK_AGENT"):
        return os.environ["HTASK_AGENT"]
    if os.environ.get("CLAUDECODE"):
        return "claude"
    if any(k.startswith("CODEX_") for k in os.environ):
        return "codex"
    return None


def log_change(conn: sqlite3.Connection, args, task_id: int, what: str, detail: str | None = None) -> None:
    conn.execute("INSERT INTO changes (task_id, at, by, what, detail) VALUES (?,?,?,?,?)",
                 (task_id, time.time(), getattr(args, "by", None) or detect_agent(), what, detail))


def origin_id() -> str | None:
    """Where the command ran: a Herdr TUI pane (w1:p2) or a Herdr app terminal (t9)."""
    return os.environ.get("HERDR_PANE_ID") or os.environ.get("HC_TERMINAL_ID")


def fetch_tasks(conn: sqlite3.Connection, project: str, archived: bool = False) -> list[sqlite3.Row]:
    """The project's tasks: the live ones, or only the archived ones."""
    return conn.execute(
        f"SELECT * FROM tasks WHERE project = ? AND archived_at IS {'NOT ' if archived else ''}NULL ORDER BY id",
        (project,)).fetchall()


# --- CLI -----------------------------------------------------------------------

def _project_from_args(args) -> str:
    return project_root(args.project or os.environ.get("HTASK_PROJECT") or os.getcwd())


def _get_task(conn, task_id: int, project: str) -> sqlite3.Row:
    row = conn.execute("SELECT * FROM tasks WHERE id = ?", (task_id,)).fetchone()
    if row is None:
        sys.exit(f"htask: no task #{task_id}")
    if row["project"] != project:
        print(f"htask: note: #{task_id} belongs to {row['project']}", file=sys.stderr)
    return row


def cmd_add(args) -> None:
    conn, now = connect(), time.time()
    project = _project_from_args(args)
    with writing(conn, project):
        cur = conn.execute(
            "INSERT INTO tasks (project, title, description, status, agent, pane_id,"
            " created_at, updated_at, completed_at) VALUES (?,?,?,?,?,?,?,?,?)",
            (project, args.title, args.description or "", args.status,
             args.agent or detect_agent(), origin_id(), now, now,
             now if args.status == "done" else None),
        )
        log_change(conn, args, cur.lastrowid, "added")
    print(f"#{cur.lastrowid} {args.title}")


def set_status(args, status: str) -> None:
    conn, now = connect(), time.time()
    project = _project_from_args(args)
    for task_id in args.ids:
        _get_task(conn, task_id, project)
        # Any status change brings an archived task back.
        fields = {"status": status, "updated_at": now, "archived_at": None,
                  "completed_at": now if status == "done" else None}
        if getattr(args, "message", None):
            fields["note"] = args.message
        sets = ", ".join(f"{k} = ?" for k in fields)
        with writing(conn, project):
            conn.execute(f"UPDATE tasks SET {sets} WHERE id = ?", (*fields.values(), task_id))
            log_change(conn, args, task_id, f"status:{status}", getattr(args, "message", None))
        print(f"#{task_id} -> {status}")


def cmd_note(args) -> None:
    conn, project = connect(), _project_from_args(args)
    _get_task(conn, args.id, project)
    with writing(conn, project):
        conn.execute("UPDATE tasks SET note = ?, updated_at = ? WHERE id = ?",
                     (args.text, time.time(), args.id))
        log_change(conn, args, args.id, "note", args.text)
    print(f"#{args.id} note set")


def cmd_edit(args) -> None:
    conn, project = connect(), _project_from_args(args)
    _get_task(conn, args.id, project)
    fields = {k: v for k, v in (("title", args.title), ("description", args.description)) if v is not None}
    if not fields:
        sys.exit("htask: edit needs --title and/or -d")
    fields["updated_at"] = time.time()
    with writing(conn, project):
        conn.execute(f"UPDATE tasks SET {', '.join(f'{k} = ?' for k in fields)} WHERE id = ?",
                     (*fields.values(), args.id))
        log_change(conn, args, args.id, "edit")
    print(f"#{args.id} updated")


def cmd_list(args) -> None:
    conn = connect()
    project = _project_from_args(args)
    rows = [r for r in fetch_tasks(conn, project, archived=args.archived)
            if args.all or args.archived or r["status"] not in ("done", "dropped")]
    if args.json:
        print(json.dumps({"project": project, "tasks": [dict(r) for r in rows]}, indent=2))
        return
    if not rows:
        print(f"no open tasks in {project}" + ("" if args.all else " (use --all for done)"))
        return
    for r in rows:
        print(f"#{r['id']:<4} [{r['status']:<7}] {r['title']}")
        if r["description"]:
            print(textwrap.indent(r["description"], " " * 16))
        if r["note"]:
            print(textwrap.indent("note: " + r["note"], " " * 16))


def cmd_summary(args) -> None:
    """One read for the app's status chip and tab-bar badge.

    Counts for the project, plus every blocked task in any project, so a
    blocked task elsewhere can still raise a notification.
    """
    conn = connect()
    project = _project_from_args(args)
    counts = dict.fromkeys(STATUSES, 0)
    for row in conn.execute("SELECT status, count(*) AS n FROM tasks WHERE project = ? AND archived_at IS NULL GROUP BY status", (project,)):
        counts[row["status"]] = row["n"]
    blocked = conn.execute(
        "SELECT id, project, title, note, agent, pane_id, updated_at FROM tasks"
        " WHERE status = 'blocked' ORDER BY updated_at").fetchall()
    print(json.dumps({"project": project, "counts": counts, "blocked": [dict(r) for r in blocked]}))


def cmd_archive(args) -> None:
    """Archive particular done or dropped tasks now. `htask reopen <id>` brings one back."""
    conn, now = connect(), time.time()
    project = _project_from_args(args)
    for task_id in args.ids:
        row = _get_task(conn, task_id, project)
        if row["status"] not in ("done", "dropped"):
            sys.exit(f"htask: #{task_id} is {row['status']}: only done or dropped tasks can be archived")
        with writing(conn, project):
            conn.execute("UPDATE tasks SET archived_at = ? WHERE id = ?", (now, task_id))
            log_change(conn, args, task_id, "archive")
        print(f"#{task_id} archived")


def cmd_clean(args) -> None:
    """Archive done and dropped tasks finished more than --days ago. `htask list --archived` shows them."""
    conn, now = connect(), time.time()
    project = None if args.everywhere else _project_from_args(args)
    where = ("status IN ('done', 'dropped') AND archived_at IS NULL"
             " AND coalesce(completed_at, updated_at) <= ?" + ("" if project is None else " AND project = ?"))
    params = (now - args.days * 86400,) + (() if project is None else (project,))
    rows = conn.execute(f"SELECT id, project, title FROM tasks WHERE {where} ORDER BY id", params).fetchall()
    scope = "every project" if project is None else project
    if args.dry_run or not rows:
        for r in rows:
            print(f"#{r['id']:<4} {r['title']}")
        print(f"{len(rows)} task(s) {'would be ' if args.dry_run and rows else ''}archived in {scope}")
        return
    with writing(conn, project):
        conn.execute(f"UPDATE tasks SET archived_at = ? WHERE {where}", (now, *params))
    print(f"archived {len(rows)} task(s) in {scope}")


def cmd_doctor(args) -> None:
    """Check that everything that uses htask can still reach it. Exit 1 if anything is broken.

    The things that break silently when the checkout moves: the ~/.local/bin links agents and
    hooks run, Claude Code hooks, the TUI plugin link, and the app mod (a copy, so it can go stale).
    """
    import hashlib
    repo = Path(__file__).resolve().parent
    home, problems = Path.home(), []

    def check(ok: bool, good: str, bad: str) -> None:
        print(("  ok  " if ok else "  !!  ") + (good if ok else bad))
        if not ok:
            problems.append(bad)

    print(f"htask checkout: {repo}")
    links = {"htask": repo / "htask", "htask-claude-inbox": repo / "hooks" / "claude-inbox.sh"}
    for name, target in links.items():
        link = home / ".local" / "bin" / name
        check(link.exists() and link.resolve() == target.resolve(),
              f"~/.local/bin/{name} -> this checkout",
              f"~/.local/bin/{name} is missing or points elsewhere: run ./install.sh")

    settings = home / ".claude" / "settings.json"
    if settings.exists():
        try:
            hooks = json.loads(settings.read_text()).get("hooks", {})
        except ValueError:
            hooks = {}
        commands = [h.get("command", "") for entries in hooks.values() for e in entries
                    for h in e.get("hooks", []) if any(k in h.get("command", "") for k in ("htask", "claude-inbox"))]
        if not commands:
            print("  --  no htask hooks in ~/.claude/settings.json (optional, see README)")
        for command in commands:
            exe = Path(os.path.expanduser(command.split()[0]))
            check(exe.exists(), f"Claude hook runs {command}",
                  f"Claude hook runs {command}, which doesn't exist")
            if exe.exists() and str(repo) in os.path.realpath(os.path.expanduser(command.split()[0])) \
                    and ".local/bin" not in command:
                check(False, "", f"Claude hook names the checkout directly ({command}): "
                                 "use ~/.local/bin/htask-claude-inbox so moving the folder can't break it")

    app_mod = Path(os.environ.get("HERDR_APP_HOME", home / ".config" / "herdr-app")) / "mods" / "htask"
    if app_mod.exists():
        digest = lambda f: hashlib.sha256(f.read_bytes()).hexdigest()
        stale = [f.name for f in (repo / "herdr-app" / "mods" / "htask").iterdir()
                 if not (app_mod / f.name).exists() or digest(f) != digest(app_mod / f.name)]
        check(not stale, "desktop-app mod matches this checkout",
              f"desktop-app mod is out of date ({', '.join(stale)}): run ./install.sh")
    else:
        print("  --  desktop-app mod not installed (optional)")

    plugins = home / ".config" / "herdr" / "plugins.json"
    entry = None
    if plugins.exists():
        try:
            entry = next((p for p in json.loads(plugins.read_text()) if p.get("plugin_id") == PLUGIN_ID), None)
        except ValueError:
            entry = None
    if entry is None:
        print("  --  Herdr terminal-UI plugin not linked (optional)")
    else:
        root = Path(entry.get("plugin_root", "")).resolve()
        check(root == repo, "Herdr terminal-UI plugin linked to this checkout",
              f"Herdr terminal-UI plugin is linked to {root}: run ./install.sh")

    try:
        conn = connect()
        n = conn.execute("SELECT count(*) FROM tasks").fetchone()[0]
        check(True, f"database {db_path()} ({n} tasks)", "")
    except sqlite3.Error as e:
        check(False, "", f"database {db_path()} can't be opened: {e}")

    print("\nall good" if not problems else f"\n{len(problems)} problem(s)")
    if problems:
        sys.exit(1)


# --- agent hooks ---------------------------------------------------------------

# Claude Code's task statuses, and the older TodoWrite list's.
CLAUDE_STATUS = {"pending": "todo", "in_progress": "doing", "completed": "done", "deleted": "dropped"}


def sync_claude(event: dict, conn: sqlite3.Connection) -> int:
    """Mirror one Claude Code PostToolUse event into the task table. Returns rows touched.

    TaskCreate/TaskUpdate carry Claude's per-session task id ("1", "2", ...):
    TaskCreate's id is only in the response ({"task": {"id": "1"}}), TaskUpdate's
    is in the input. TodoWrite resends the whole list each time, keyed by text.
    """
    tool, inp = event.get("tool_name"), event.get("tool_input") or {}
    resp = event.get("tool_response") or {}
    session, now = event.get("session_id") or "unknown", time.time()
    project = project_root(event.get("cwd") or os.getcwd())

    def upsert(key, title=None, description=None, status=None) -> int:
        row = conn.execute("SELECT id FROM tasks WHERE external_id = ?", (key,)).fetchone()
        if row is None and title is not None:
            # Claude may have run `htask add` for the same step too (a session without the task
            # tool falls back to htask; a confused one does both). Link to that task instead of
            # adding a duplicate: same repo, same terminal, same title, not yet linked, not archived.
            row = conn.execute(
                "SELECT id FROM tasks WHERE external_id IS NULL AND archived_at IS NULL AND project = ?"
                " AND pane_id IS ? AND lower(trim(title)) = lower(trim(?)) ORDER BY id DESC LIMIT 1",
                (project, origin_id(), title)).fetchone()
            if row is not None:
                conn.execute("UPDATE tasks SET external_id = ? WHERE id = ?", (key, row["id"]))
        if row is None:
            if title is None:
                return 0  # an update for a task created before the hook existed
            conn.execute(
                "INSERT INTO tasks (project, title, description, status, agent, pane_id,"
                " created_at, updated_at, completed_at, external_id) VALUES (?,?,?,?,?,?,?,?,?,?)",
                (project, title, description or "", status or "todo", "claude", origin_id(),
                 now, now, now if status == "done" else None, key))
            return 1
        fields = {k: v for k, v in (("title", title), ("description", description), ("status", status)) if v is not None}
        if not fields:
            return 0
        fields["updated_at"] = now
        if status is not None:
            fields["completed_at"] = now if status == "done" else None
        conn.execute(f"UPDATE tasks SET {', '.join(f'{k} = ?' for k in fields)} WHERE id = ?",
                     (*fields.values(), row["id"]))
        return 1

    prefix = f"claude:{session}:"
    if tool == "TaskCreate":
        task_id = (resp.get("task") or {}).get("id") if isinstance(resp, dict) else None
        if task_id is None:
            return 0
        return upsert(prefix + str(task_id), inp.get("subject") or "(untitled)", inp.get("description"), "todo")
    if tool == "TaskUpdate" and inp.get("taskId") is not None:
        return upsert(prefix + str(inp["taskId"]), inp.get("subject"), inp.get("description"),
                      CLAUDE_STATUS.get(inp.get("status")))
    if tool == "TodoWrite":
        return sum(upsert(prefix + "todo:" + t.get("content", ""), t.get("content", ""), None,
                          CLAUDE_STATUS.get(t.get("status"), "todo"))
                   for t in inp.get("todos") or [] if t.get("content"))
    return 0


STATUS_WORDS = {"done": "done", "dropped": "dropped", "todo": "back to to-do", "doing": "in progress",
                "blocked": "blocked"}


def human_changes(conn: sqlite3.Connection, session: str, cwd: str, pane: str | None) -> list[str]:
    """What the human changed since this Claude session last asked, as lines for its context.

    Only changes made with --by you, and only to tasks that concern the session: its own
    (mirrored from its task tool, or made from its terminal), plus tasks the human added to
    its repo. The first call only sets the cursor: an old backlog isn't news.
    """
    latest = conn.execute("SELECT coalesce(max(id), 0) FROM changes").fetchone()[0]
    row = conn.execute("SELECT last_change FROM hook_cursor WHERE session = ?", (session,)).fetchone()
    with conn:
        conn.execute("INSERT INTO hook_cursor (session, last_change) VALUES (?, ?)"
                     " ON CONFLICT(session) DO UPDATE SET last_change = excluded.last_change", (session, latest))
    if row is None:
        return []
    rows = conn.execute(
        "SELECT c.what, c.detail, t.id, t.title, t.project, t.pane_id, t.external_id FROM changes c"
        " JOIN tasks t ON t.id = c.task_id WHERE c.id > ? AND c.by = 'you' ORDER BY c.id",
        (row["last_change"],)).fetchall()
    project, mine = None, f"claude:{session}:"
    lines = []
    for r in rows:
        if r["what"] == "added":
            # A task the human added belongs to no agent yet: news for every session in its repo.
            project = project or project_root(cwd)
            if r["project"] != project:
                continue
        elif not ((r["external_id"] or "").startswith(mine) or (pane is not None and r["pane_id"] == pane)):
            continue
        ref = f'htask #{r["id"]} "{r["title"]}"'
        claude_id = (r["external_id"] or "")[len(mine):] if (r["external_id"] or "").startswith(mine) else None
        yours = f" (your task {claude_id})" if claude_id and not claude_id.startswith("todo:") else ""
        if r["what"] == "added":
            lines.append(f"The human added {ref} to this repo's task list.")
        elif r["what"].startswith("status:"):
            status = r["what"].split(":", 1)[1]
            lines.append(f"The human marked {ref}{yours} {STATUS_WORDS.get(status, status)}"
                         + (f': "{r["detail"]}"' if r["detail"] else "") + ".")
        elif r["what"] == "note":
            lines.append(f'The human left a note on {ref}{yours}: "{r["detail"]}".')
        elif r["what"] == "edit":
            lines.append(f"The human edited {ref}{yours}; run `htask list` to see it.")
    if lines:
        lines.append("These changes came from the Herdr task panel. Update your own task list to match"
                     " (TaskUpdate), so your next update doesn't undo them.")
    return lines


def cmd_inbox(args) -> None:
    """Claude Code hook (PostToolUse, UserPromptSubmit): pass on the human's task changes."""
    try:
        event = json.load(sys.stdin)
        conn = connect()
        lines = human_changes(conn, event.get("session_id") or "unknown",
                              event.get("cwd") or os.getcwd(), origin_id())
        if lines:
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": event.get("hook_event_name", "PostToolUse"),
                "additionalContext": "\n".join(lines)}}))
    except Exception as e:  # noqa: BLE001 - a broken hook must not block the agent
        print(f"htask inbox: {e}", file=sys.stderr)


def cmd_hook(args) -> None:
    """Hook entry point. Never fails the agent's tool call: errors go to stderr, exit 0."""
    if args.agent == "claude-inbox":
        return cmd_inbox(args)
    try:
        event = json.load(sys.stdin)
        conn = connect()
        with writing(conn, project_root(event.get("cwd") or os.getcwd())):
            sync_claude(event, conn)
    except Exception as e:  # noqa: BLE001 - a broken hook must not block the agent
        print(f"htask hook: {e}", file=sys.stderr)


def cmd_plugin_open(args) -> None:
    """Plugin action: open the panel in a right split beside the focused pane."""
    herdr = os.environ.get("HERDR_BIN_PATH", "herdr")
    ctx = json.loads(os.environ.get("HERDR_PLUGIN_CONTEXT_JSON") or "{}")
    cmd = [herdr, "plugin", "pane", "open", "--plugin", PLUGIN_ID,
           "--entrypoint", "panel", "--placement", "split", "--direction", "right"]
    if ctx.get("focused_pane_id"):
        cmd += ["--target-pane", ctx["focused_pane_id"]]
    out = subprocess.run(cmd, capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(out.stderr or out.stdout)
    try:
        pane_id = json.loads(out.stdout)["result"]["plugin_pane"]["pane"]["pane_id"]
        subprocess.run([herdr, "pane", "rename", pane_id, "tasks"], capture_output=True)
    except (KeyError, ValueError, TypeError):
        pass


# --- panel ---------------------------------------------------------------------

def focused_context(prev: dict | None) -> dict:
    """Which pane the panel should follow: {pane_id, cwd, agent}.

    Polls `herdr pane current` (the focused pane). When the user focuses the
    panel itself, keep showing the pane they came from.
    """
    own = os.environ.get("HERDR_PANE_ID")
    if os.environ.get("HERDR_ENV") != "1":
        return prev or {"pane_id": None, "cwd": os.getcwd(), "agent": None}
    if prev is None:
        ctx = json.loads(os.environ.get("HERDR_PLUGIN_CONTEXT_JSON") or "{}")
        prev = {"pane_id": ctx.get("focused_pane_id"),
                "cwd": ctx.get("focused_pane_cwd") or ctx.get("workspace_cwd") or os.getcwd(),
                "agent": ctx.get("focused_pane_agent")}
    herdr = os.environ.get("HERDR_BIN_PATH", "herdr")
    # `pane current` answers for the caller's HERDR_PANE_ID when it is set,
    # which would be this panel. Without it, Herdr reports the focused pane.
    env = {k: v for k, v in os.environ.items() if k != "HERDR_PANE_ID"}
    try:
        out = subprocess.run([herdr, "pane", "current"], capture_output=True,
                             text=True, timeout=2, env=env)
        pane = json.loads(out.stdout)["result"]["pane"]
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired):
        return prev
    if pane.get("pane_id") == own:
        return prev
    return {"pane_id": pane.get("pane_id"),
            "cwd": pane.get("foreground_cwd") or pane.get("cwd") or prev["cwd"],
            "agent": pane.get("agent")}


DONE_SHOWN = 5  # done tasks shown; the rest are a "+N more" line (htask clean clears them)


def order_tasks(tasks: list[sqlite3.Row], focused_pane_id: str | None,
                show_done: bool, show_todo: bool = True) -> list[tuple[str, list[sqlite3.Row], int]]:
    """The panel's sections in display order, as (title, rows, hidden count).

    Same policy as the app panel's sections(): Blocked first because it needs
    you; within each open section the focused pane's tasks first, then id order
    (sorted() is stable); Done shows the newest few; dropped tasks don't show.
    Empty sections are skipped by the renderer.
    """
    def by(status):
        rows = [t for t in tasks if t["status"] == status]
        return sorted(rows, key=lambda t: not (focused_pane_id and t["pane_id"] == focused_pane_id))
    sections = [("BLOCKED", by("blocked"), 0), ("IN PROGRESS", by("doing"), 0)]
    if show_todo:
        sections.append(("TO DO", by("todo"), 0))
    if show_done:
        done = sorted((t for t in tasks if t["status"] == "done"),
                      key=lambda t: t["completed_at"] or 0, reverse=True)
        sections.append(("DONE", done[:DONE_SHOWN], max(0, len(done) - DONE_SHOWN)))
    return sections


def run_panel(args) -> None:
    import curses
    curses.wrapper(lambda scr: _panel(scr, args))


STATUS_GLYPH = {"todo": "○", "doing": "◐", "blocked": "✗", "done": "●", "dropped": "–"}


def _panel(scr, args) -> None:
    import curses
    curses.curs_set(0)
    curses.use_default_colors()
    palette = {"doing": curses.COLOR_YELLOW, "blocked": curses.COLOR_RED,
               "todo": curses.COLOR_CYAN, "done": curses.COLOR_GREEN,
               "dropped": curses.COLOR_WHITE, "head": curses.COLOR_MAGENTA}
    color = {}
    for i, (name, fg) in enumerate(palette.items(), start=1):
        curses.init_pair(i, fg, -1)
        color[name] = curses.color_pair(i)
    scr.timeout(400)

    conn = connect()
    ctx, last_poll, last_version = None, 0.0, None
    show_done, show_desc, show_archived, show_todo, scroll = True, True, False, True, 0
    lines: list[tuple[str, int]] = []
    dirty = True

    while True:
        now = time.monotonic()
        if args.project is None and now - last_poll > 1.0:
            new_ctx = focused_context(ctx)
            dirty |= new_ctx != ctx
            ctx, last_poll = new_ctx, now
        elif ctx is None:
            ctx = {"pane_id": None, "cwd": args.project, "agent": None}
        version = conn.execute("PRAGMA data_version").fetchone()[0]
        dirty |= version != last_version
        last_version = version

        h, w = scr.getmaxyx()
        if dirty:
            project = project_root(ctx["cwd"])
            tasks = fetch_tasks(conn, project)
            archived = sorted(fetch_tasks(conn, project, archived=True),
                              key=lambda t: t["archived_at"] or 0, reverse=True) if show_archived else None
            lines = _render(tasks, project, ctx, w, show_done, show_desc, color, archived, show_todo)
            dirty = False
        scroll = max(0, min(scroll, len(lines) - h))
        scr.erase()
        for y, (text, attr) in enumerate(lines[scroll:scroll + h]):
            try:
                scr.addnstr(y, 0, text, w - 1, attr)
            except curses.error:
                pass
        scr.refresh()

        key = scr.getch()
        if key in (ord("q"), 27):
            return
        if key in (ord("j"), curses.KEY_DOWN):
            scroll += 1
        elif key in (ord("k"), curses.KEY_UP):
            scroll = max(0, scroll - 1)
        elif key == ord("d"):
            show_done, dirty = not show_done, True
        elif key == ord("a"):
            show_archived, dirty = not show_archived, True
        elif key == ord("t"):
            show_todo, dirty = not show_todo, True
        elif key == ord("v"):
            show_desc, dirty = not show_desc, True
        elif key == curses.KEY_RESIZE:
            dirty = True


def _render(tasks, project, ctx, width, show_done, show_desc, color, archived=None,
            show_todo=True) -> list[tuple[str, int]]:
    import curses
    width = max(width - 1, 20)
    open_ = [t for t in tasks if t["status"] not in ("done", "dropped")]
    done = [t for t in tasks if t["status"] == "done"]
    total = len(open_) + len(done)
    bar_w = max(width - 12, 5)
    filled = round(bar_w * len(done) / total) if total else 0

    out: list[tuple[str, int]] = [
        (os.path.basename(project) or project, color["head"] | curses.A_BOLD),
        (f"{ctx.get('agent') or 'no agent'}  {ctx.get('pane_id') or ''}", curses.A_DIM),
        ("█" * filled + "░" * (bar_w - filled) + f" {len(done)}/{total}", color["done"]),
        ("", 0),
    ]
    sections = order_tasks(tasks, ctx.get("pane_id"), show_done, show_todo)
    # "›" (this pane's task) only tells tasks apart when the open ones come from more than one
    # pane, and never on finished rows.
    mixed = len({t["pane_id"] for t in tasks if t["status"] not in ("done", "dropped") and t["pane_id"]}) > 1
    if not any(rows for _, rows, _ in sections):
        out.append(("No tasks yet.", curses.A_DIM))
        out.append(('Agents add them with: htask add "title" -d "..."', curses.A_DIM))
    for title, rows, more in sections:
        if not rows:
            continue
        out.append((f"{title} ({len(rows) + more})", curses.A_BOLD | curses.A_UNDERLINE))
        for t in rows:
            mine = "›" if (mixed and t["status"] not in ("done", "dropped") and ctx.get("pane_id")
                           and t["pane_id"] == ctx["pane_id"]) else " "
            head = f"{mine}{STATUS_GLYPH[t['status']]} #{t['id']} "
            attr = color[t["status"]] | (curses.A_DIM if t["status"] == "done" else 0)
            wrapped = textwrap.wrap(t["title"], width - len(head)) or [""]
            out.append((head + wrapped[0], attr))
            out.extend((" " * len(head) + extra, attr) for extra in wrapped[1:])
            if show_desc and t["status"] != "done":
                for field, prefix in (("description", ""), ("note", "↳ ")):
                    if t[field]:
                        for line in textwrap.wrap(prefix + t[field], width - len(head)):
                            out.append((" " * len(head) + line, curses.A_DIM))
        if more:
            out.append((f"      +{more} more (htask clean to clear)", curses.A_DIM))
        out.append(("", 0))
    if archived is not None:
        # Archived tasks (`a`): newest first, dimmed. `htask reopen <id>` brings one back.
        out.append((f"ARCHIVED ({len(archived)})", curses.A_BOLD | curses.A_UNDERLINE))
        if not archived:
            out.append(("  Nothing archived in this repo.", curses.A_DIM))
        for t in archived:
            out.append((f" {STATUS_GLYPH[t['status']]} #{t['id']} {t['title']}", curses.A_DIM))
        out.append(("", 0))
    out.append(("q quit  j/k scroll  t to-do  d done  a archived  v details", curses.A_DIM))
    return out


# --- entry ---------------------------------------------------------------------

def main(argv=None) -> None:
    p = argparse.ArgumentParser(prog="htask", description=__doc__.split("\n\n")[0])
    p.add_argument("--project", help="project dir (default: git root of cwd)")
    p.add_argument("--by", help="who is making the change (the app panel passes 'you')")
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add", help="create a task, prints its id")
    a.add_argument("title")
    a.add_argument("-d", "--description")
    a.add_argument("--status", choices=STATUSES, default="todo")
    a.add_argument("--agent", help="who added it (default: detected from the environment)")
    a.set_defaults(fn=cmd_add)

    for name, status, helptext in (
        ("start", "doing", "mark tasks in progress"),
        ("done", "done", "mark tasks complete"),
        ("block", "blocked", "mark tasks blocked (-m reason)"),
        ("drop", "dropped", "abandon tasks"),
        ("reopen", "todo", "move tasks back to todo"),
    ):
        s = sub.add_parser(name, help=helptext)
        s.add_argument("ids", type=int, nargs="+")
        s.add_argument("-m", "--message", help="also set the task's note")
        s.set_defaults(fn=lambda args, st=status: set_status(args, st))

    n = sub.add_parser("note", help="set a progress note on a task")
    n.add_argument("id", type=int)
    n.add_argument("text")
    n.set_defaults(fn=cmd_note)

    e = sub.add_parser("edit", help="change title or description")
    e.add_argument("id", type=int)
    e.add_argument("--title")
    e.add_argument("-d", "--description")
    e.set_defaults(fn=cmd_edit)

    ls = sub.add_parser("list", help="list this project's open tasks")
    ls.add_argument("--all", action="store_true", help="include done/dropped")
    ls.add_argument("--json", action="store_true")
    ls.add_argument("--archived", action="store_true", help="only tasks put away by `htask clean`")
    ls.set_defaults(fn=cmd_list)

    ar = sub.add_parser("archive", help="archive done or dropped tasks now")
    ar.add_argument("ids", type=int, nargs="+")
    ar.set_defaults(fn=cmd_archive)

    cl = sub.add_parser("clean", help="archive done/dropped tasks older than --days")
    cl.add_argument("--days", type=float, default=7, help="age in days (default 7; 0 = all done)")
    cl.add_argument("--everywhere", action="store_true", help="every project, not just this one")
    cl.add_argument("--dry-run", action="store_true", help="list what would be archived")
    cl.set_defaults(fn=cmd_clean)

    sub.add_parser("doctor", help="check the install: links, hooks, app mod, TUI plugin, DB").set_defaults(fn=cmd_doctor)

    sm = sub.add_parser("summary", help="JSON counts for this project and blocked tasks everywhere")
    sm.set_defaults(fn=cmd_summary)

    hk = sub.add_parser("hook", help="agent hook: mirror the agent's own task list (reads stdin)")
    hk.add_argument("agent", choices=["claude", "claude-inbox"],
                    help="claude: mirror its task tool; claude-inbox: tell it what the human changed")
    hk.set_defaults(fn=cmd_hook)

    sub.add_parser("panel", help="run the TUI panel").set_defaults(fn=run_panel)
    sub.add_parser("plugin-open", help=argparse.SUPPRESS).set_defaults(fn=cmd_plugin_open)

    args = p.parse_args(argv)
    args.fn(args)


if __name__ == "__main__":
    main()
