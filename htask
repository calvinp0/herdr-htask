CONNECT_AGENTS = {
    "claude": ("Claude Code", ".claude", "CLAUDE.md", CLAUDE_INSTRUCTIONS),
    "codex": ("Codex", ".codex", "AGENTS.md", CODEX_INSTRUCTIONS),
    "pi": ("Pi", ".pi/agent", "AGENTS.md", AGENT_INSTRUCTIONS),
}


def agent_hooks(key: str) -> tuple[Path, list[tuple[str, str | None, str, str]]] | None:
    """Where an agent's hooks live, and htask's: (event, matcher, command, kind) each. None: no hooks."""
    home, bin_dir = Path.home(), Path.home() / ".local" / "bin"
    if key == "claude":
        return home / ".claude" / "settings.json", [
            ("PostToolUse", "TaskCreate|TaskUpdate|TodoWrite|ExitPlanMode", f"{bin_dir / 'htask'} hook claude", "mirror"),
            ("PostToolUse", "*", str(bin_dir / "htask-claude-inbox"), "inbox"),
            ("UserPromptSubmit", None, str(bin_dir / "htask-claude-inbox"), "inbox"),
        ]
    if key == "codex":
        codex_home = Path(os.environ.get("CODEX_HOME") or home / ".codex")
        return codex_home / "hooks.json", [
            ("PostToolUse", "^update_plan$", f"{bin_dir / 'htask'} hook codex", "mirror"),
        ]
    return None


def _hook_kind(command: str) -> str | None:
    if "claude-inbox" in command:
        return "inbox"
    if "htask" in command and ("hook claude" in command or "hook codex" in command):
        return "mirror"
    return None


def codex_hooks_enabled() -> bool:
    """Codex runs hooks only with [features] hooks = true in its config.toml."""
    config = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex") / "config.toml"
    try:
        text = config.read_text()
    except OSError:
        return False
    try:
        import tomllib  # Python 3.11+
        return bool(tomllib.loads(text).get("features", {}).get("hooks"))
    except ImportError:
        pass
    except ValueError:
        return False
    # Python 3.10: find `hooks = true` in the [features] table.
    table = None
    for line in text.splitlines():
        line = line.split("#", 1)[0].strip()
        if line.startswith("["):
            table = line.strip("[] ")
        elif table == "features" and line.replace(" ", "") == "hooks=true":
            return True
    return False


def _apply_hooks(path: Path, specs, remove: bool) -> str | None:
    """Add htask's hooks to (or take them out of) a Claude/Codex hooks JSON file. Returns what changed."""
    try:
        data = json.loads(path.read_text()) if path.exists() else {}
    except ValueError:
        raise SystemExit(f"htask: {path} isn't valid JSON; not touching it")
    hooks = data.setdefault("hooks", {})
    changed = False
    if remove:
        for event in list(hooks):
            kept = []
            for e in hooks[event]:
                ours = [h for h in e.get("hooks", []) if _hook_kind(h.get("command", ""))]
                changed |= bool(ours)
                e["hooks"] = [h for h in e.get("hooks", []) if not _hook_kind(h.get("command", ""))]
                if e["hooks"]:
                    kept.append(e)
            hooks[event] = kept
            if not kept:
                del hooks[event]
        if not hooks:
            del data["hooks"]
    else:
        for event, matcher, command, kind in specs:
            entries = hooks.setdefault(event, [])
            match, match_entry = None, None
            for e in entries:
                for h in e.get("hooks", []):
                    if _hook_kind(h.get("command", "")) == kind and (e.get("matcher") == matcher or kind == "mirror"):
                        match, match_entry = h, e
            if match is not None and kind == "mirror" and matcher is not None and match_entry.get("matcher") != matcher:
                match_entry["matcher"] = matcher  # an older htask's matcher: catch the tools added since
                changed = True
            if match is None:
                entry = {"hooks": [{"type": "command", "command": command, "timeout": 10}]}
                if matcher is not None:
                    entry = {"matcher": matcher, **entry}
                entries.append(entry)
                changed = True
            elif match.get("command") != command:
                match["command"] = command  # an old path (inside the checkout): use the stable link
                changed = True
    # Write only when a hook was actually added, repointed or removed: never just to reformat.
    if not changed:
        return None
    after = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    backup = _backup(path)
    path.write_text(after)
    json.loads(path.read_text())  # never leave it unparseable
    return f"{'removed' if remove else 'set up'} the htask hooks in {path}" + (f" (backup: {backup.name})" if backup else "")


def _backup(path: Path) -> Path | None:
    if not path.exists():
        return None
    stamp, n = time.strftime("%Y%m%d-%H%M%S"), 1
    copy = path.with_name(f"{path.name}.bak-htask-{stamp}")
    while copy.exists():  # two changes in one second must not overwrite the first backup
        n += 1
        copy = path.with_name(f"{path.name}.bak-htask-{stamp}-{n}")
    copy.write_bytes(path.read_bytes())
    return copy


def _has_instructions(text: str) -> bool:
    return HEADING in text


def _strip_instructions(text: str) -> str:
    """Remove the htask section: the marked block, or (added by hand) the heading to the next ## heading."""
    if MARK_START in text and MARK_END in text:
        start, end = text.index(MARK_START), text.index(MARK_END) + len(MARK_END)
    elif HEADING in text:
        start = text.index(HEADING)
        nxt = text.find("\n## ", start + len(HEADING))
        end = len(text) if nxt == -1 else nxt + 1
    else:
        return text
    before, after = text[:start].rstrip("\n"), text[end:].lstrip("\n")
    joined = f"{before}\n\n{after}" if before and after else (before or after)
    return joined.rstrip("\n") + "\n" if joined else ""


def connect_status() -> dict:
    home, out = Path.home(), {}
    for key, (name, folder, file, _text) in CONNECT_AGENTS.items():
        available = (home / folder).is_dir()
        instructions_file = home / folder / file
        instructions = instructions_file.exists() and _has_instructions(instructions_file.read_text())
        entry = {"name": name, "available": available, "instructions": instructions,
                 "file": str(instructions_file)}
        parts = [instructions]
        spec = agent_hooks(key)
        if spec:
            path, specs = spec
            wanted = {(ev, kind) for ev, _m, _c, kind in specs}
            found = dict.fromkeys(sorted(f"{kind}:{ev}" for ev, kind in wanted), False)
            try:
                hooks = json.loads(path.read_text()).get("hooks", {}) if path.exists() else {}
            except ValueError:
                hooks = {}
            for event, entries in hooks.items():
                for e in entries:
                    for h in e.get("hooks", []):
                        kind = _hook_kind(h.get("command", ""))
                        if (event, kind) in wanted:
                            found[f"{kind}:{event}"] = True
            entry["hooks"] = found
            parts += list(found.values())
        if key == "codex":
            entry["hooks_enabled"] = codex_hooks_enabled()
        entry["connected"] = available and all(parts)
        entry["partial"] = available and any(parts) and not all(parts)
        out[key] = entry
    return out


def connect_agent(key: str, remove: bool = False) -> list[str]:
    """Add (or with remove=True take out) htask's instructions, and for Claude Code its hooks.

    Returns what was done, for people. Backs up every file before changing it.
    """
    name, folder, file, text = CONNECT_AGENTS[key]
    home, done = Path.home(), []
    if not (home / folder).is_dir():
        raise SystemExit(f"htask: {name} isn't set up here (~/{folder} is missing)")

    path = home / folder / file
    current = path.read_text() if path.exists() else ""
    if remove and _has_instructions(current):
        backup = _backup(path)
        path.write_text(_strip_instructions(current))
        done.append(f"removed the htask section from {path} (backup: {backup.name})")
    elif not remove and not _has_instructions(current):
        backup = _backup(path)
        sep = "" if not current or current.endswith("\n\n") else ("\n" if current.endswith("\n") else "\n\n")
        path.write_text(f"{current}{sep}{MARK_START}\n{text}{MARK_END}\n")
        done.append(f"added the htask section to {path}" + (f" (backup: {backup.name})" if backup else ""))
    elif not remove and MARK_START in current and MARK_END in current:
        # Our own marked section from an older htask: bring it up to date. Hand-written ones stay.
        start, end = current.index(MARK_START), current.index(MARK_END) + len(MARK_END)
        block = f"{MARK_START}\n{text}{MARK_END}"
        if current[start:end] != block:
            backup = _backup(path)
            path.write_text(current[:start] + block + current[end:])
            done.append(f"updated the htask section in {path} (backup: {backup.name})")

    spec = agent_hooks(key)
    if spec:
        changed = _apply_hooks(spec[0], spec[1], remove)
        if changed:
            done.append(changed)
    if key == "codex" and not remove and not codex_hooks_enabled():
        done.append("note: Codex runs hooks only with [features] hooks = true in its config.toml; add it to mirror plans")
    return done


def cmd_connect(args) -> None:
    if args.target == "status":
        status = connect_status()
        if args.json:
            print(json.dumps(status))
            return
        for key, s in status.items():
            state = ("not installed" if not s["available"] else "connected" if s["connected"]
                     else "partly connected" if s["partial"] else "not connected")
            print(f"{s['name']:<12} {state}")
        return
    targets = [k for k, s in connect_status().items() if s["available"]] if args.target == "all" else [args.target]
    codex_hook_changed = False
    for key in targets:
        done = connect_agent(key, remove=args.remove)
        name = CONNECT_AGENTS[key][0]
        codex_hook_changed |= key == "codex" and any("hooks" in d for d in done)
        print(f"{name}: " + ("; ".join(done) if done else ("nothing to remove" if args.remove else "already connected")))
    if not args.remove:
        print("Agents started from now on pick it up; running ones keep their old setup until restarted.")
        if codex_hook_changed:
            print("Codex asks you to approve a new hook the next time it starts.")


